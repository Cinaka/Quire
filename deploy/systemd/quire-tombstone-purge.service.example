[Unit]
Description=Quire expired tombstone cleanup
After=mysql.service

[Service]
Type=oneshot
User=quire
Group=quire
WorkingDirectory=/srv/quire/backend
EnvironmentFile=/srv/quire/backend/.env
ExecStart=/opt/anaconda3/envs/quire/bin/python -m app.jobs.purge_tombstones --days 180 --batch-size 500
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quire/media
