{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:p3": "node scripts/test-checkins.cjs",
    "check:p3": "npm run test:p3 && npm run build",
    "test:p4": "node scripts/test-schedules.cjs",
    "check:p4": "npm run test:p4 && npm run build",
    "test:p4:sync": "node scripts/test-schedules.cjs --group sync",
    "check:p4:sync": "npm run test:p4:sync && npm run build",
    "test:p5": "node scripts/test-notebook.cjs",
    "check:p5": "npm run test:p5 && npm run build",
    "check:p5:browser": "vue-tsc --noEmit -p tsconfig.notebook-browser.json && npm run check:p5",
    "verify:p5:browser": "vite --config vite.notebook-browser.config.ts",
    "check:p5:integration": "npm run test:p3 && npm run test:p4 && npm run check:p5:browser",
    "test:p6": "node scripts/test-print.cjs",
    "check:p6": "npm run test:p6 && npm run build",
    "check:p6:integration": "node scripts/test-print.cjs --integration",
    "test:uuid32": "node --experimental-vm-modules --test tests/uuid-hex.test.cjs tests/uuid-business.test.cjs tests/security-media.test.cjs tests/uuid-storage-cutover.test.cjs tests/uuid-backup-restore.test.cjs"
  },
  "dependencies": {
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/vue-3": "^2.27.2",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.5",
    "lunar-javascript": "^1.7.7",
    "lunar-typescript": "^1.8.6",
    "uuid": "^14.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
